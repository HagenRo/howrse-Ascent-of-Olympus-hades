{
    "name": "Howrse Hades Tracker",
    "version": "0",
    "description": "write statistics to csv",
    "icons": {
        "16": "app/UI/icons/icon16.png",
        "128": "app/UI/icons/icon128.jpg"
    },
    "manifest_version": 3,
    "permissions": [
        "pageCapture",
        "unlimitedStorage",
        "storage",
        "downloads",
        "offscreen"
    ],
    "options_page": "app/UI/settings/settings.html",
    "action": {
        "default_title": "Chrome Addon v3 Starter",
        "default_popup": "app/UI/popup/popup.html",
        "default_icon": {
            "16": "app/UI/icons/icon16.png",
            "128": "app/UI/icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "app/BackroundScripts/background.js"
    },
    "content_scripts": [
        {
            "js": [
                "app/jquery.js",
                "app/ContentScripts/OlympLogging/detailedLogging.js",
                "app/ContentScripts/RewardStatistic/extract.js",
                "app/ContentScripts/OlympObolusTracker/rememberme.js",
                "app/ContentScripts/OlympHelper/olympHelper.js",
                "app/correctionFunktions.js"
            ],
            "matches": [
                "https://www.howrse.com/rowgue/*",
                "https://www.howrse.de/rowgue/*",
                "https://www.howrse.se/rowgue/*",
                "https://www.howrse.co.uk/rowgue/*",
                "https://nl.howrse.com/rowgue/*",
                "https://au.howrse.com/rowgue/*",
                "https://www.preprod.howrse.de/rowgue/*"
            ] 
        }
    ]
}